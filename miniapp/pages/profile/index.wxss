.ident {
  display: flex;
  align-items: center;
  padding: 44rpx 32rpx 36rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--line);
}

.avatar-btn {
  flex: none;
  width: 132rpx;
  height: 132rpx;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 28rpx;
  background: var(--bg-alt);
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  color: var(--ink-3);
  border: 1rpx dashed var(--line-2);
}

.ident-main {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.nick {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink);
}

.nick-ph {
  color: var(--ink-3);
  font-size: 30rpx;
  font-weight: 400;
}

.ident-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

/* ---------- 统计 ---------- */
.stats {
  display: flex;
  padding: 32rpx 16rpx;
  background: var(--card);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-n {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--brand);
}

.stat-l {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ---------- 进度 ---------- */
.prog {
  margin: 0 32rpx;
}

.prog-row {
  margin-bottom: 26rpx;
}

.prog-row:last-of-type {
  margin-bottom: 0;
}

.prog-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.prog-name {
  font-size: 27rpx;
  color: var(--ink-body);
}

.prog-val {
  font-size: 24rpx;
  color: var(--ink-3);
}

.prog-bar {
  height: 12rpx;
  background: var(--bg-alt);
  border-radius: 6rpx;
  overflow: hidden;
}

.prog-fill {
  height: 12rpx;
  background: var(--brand);
  border-radius: 6rpx;
}

.prog-note {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

/* ---------- 设置列表 ---------- */
.list {
  margin: 0 32rpx;
  padding: 0;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row-hover {
  background: var(--bg);
}

.row-t {
  font-size: 29rpx;
  color: var(--ink);
}

.row-a {
  font-size: 25rpx;
  color: var(--ink-3);
}

/* ---------- 云端状态 ---------- */
.cloud {
  margin: 30rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: var(--accent-soft);
  border: 1rpx solid var(--accent-line, #F2D675);
  border-radius: 16rpx;
  font-size: 23rpx;
  color: var(--accent-deep, #854F0B);
  line-height: 1.7;
}

.cloud.ok {
  background: var(--brand-wash);
  border-color: var(--brand-line);
  color: var(--brand-dark);
}

.foot {
  padding: 50rpx 40rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.foot-2 {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.foot {
  font-size: 22rpx;
  color: var(--ink-3);
}
