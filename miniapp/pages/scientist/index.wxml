<block wx:if="{{s}}">
  <view class="head">
    <image class="head-icon" src="{{s.iconMini}}" mode="aspectFit"></image>
    <text class="head-name">{{s.fullName}}</text>
    <text class="head-en" wx:if="{{s.enName}}">{{s.enName}}</text>
    <view class="head-meta">
      <text class="head-years">{{s.years}}</text>
      <view class="head-strip" style="background: {{s.discColor}}"></view>
      <text class="head-disc">{{s.disc}}</text>
    </view>
    <text class="head-tag">{{s.tagline}}</text>
    <view class="head-tags" wx:if="{{s.keywords.length > 0}}">
      <text class="head-tag-chip" wx:for="{{s.keywords}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="entries">
    <view class="entry" bindtap="openTimeline" hover-class="entry-hover">
      <view class="entry-main">
        <text class="entry-t">生平时间轴</text>
        <text class="entry-s" wx:if="{{tlStat}}">{{tlStat.from}} – {{tlStat.to}} · {{tlStat.nodes}} 个节点，每个节点对照同期中国</text>
        <text class="entry-s" wx:else>这位科学家的时间轴还没迁移过来</text>
      </view>
      <text class="entry-a">›</text>
    </view>

    <view class="entry" wx:if="{{details.length > 0}}">
      <view class="entry-main">
        <text class="entry-t">成就详解</text>
        <text class="entry-s">把每项成就讲清楚：原理、证据、为什么重要</text>
      </view>
    </view>
    <view
      class="entry-sub"
      wx:for="{{details}}"
      wx:key="slug"
      data-slug="{{item.slug}}"
      bindtap="openDetail"
      hover-class="entry-hover"
    >
      <text class="entry-n">{{item.title}}</text>
      <text class="entry-a">›</text>
    </view>
  </view>

  <view class="search">
    <input
      class="search-input"
      value="{{q}}"
      placeholder="在这位科学家的 {{s.termCount}} 条术语里搜"
      placeholder-class="search-ph"
      bindinput="onSearch"
    />
  </view>

  <view wx:for="{{groups}}" wx:key="cat" wx:for-item="g">
    <view class="section-title">{{g.cat}}</view>
    <view class="terms">
      <view
        class="term"
        wx:for="{{g.items}}"
        wx:key="k"
        data-k="{{item.k}}"
        bindtap="openTerm"
        hover-class="term-hover"
      >
        <view class="term-top">
          <text class="term-name">{{item.name}}</text>
          <text class="term-more">展开</text>
        </view>
        <rich-text class="term-short" nodes="{{item.short}}"></rich-text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{groups.length === 0}}">
    <text>没有匹配的术语</text>
  </view>
</block>

<term-popup
  show="{{show}}"
  term="{{term}}"
  sciName="{{s.shortName}}"
  related="{{related}}"
  bind:close="closeTerm"
  bind:related="onRelated"
/>
