.tp-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 30, 45, 0.42);
  z-index: 900;
}

.tp-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(27, 37, 48, 0.12);
  animation: tp-up 0.22s ease-out;
  padding-bottom: env(safe-area-inset-bottom);
}

@keyframes tp-up {
  from {
    transform: translateY(40rpx);
    opacity: 0.4;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.tp-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.tp-head-main {
  flex: 1;
  min-width: 0;
}

.tp-name {
  display: block;
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.3;
}

.tp-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.tp-close {
  flex: none;
  margin-left: 20rpx;
  padding: 6rpx 20rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  background: var(--bg-alt);
  border-radius: 999rpx;
}

.tp-close-hover {
  background: var(--line-2);
}

.tp-body {
  flex: 1;
  padding: 0 32rpx;
}

.tp-short {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--accent-soft);
  border-left: 6rpx solid var(--accent);
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.tp-block {
  margin-top: 32rpx;
}

.tp-label {
  display: block;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 500;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.tp-text {
  font-size: 29rpx;
  color: var(--ink-body);
  line-height: 1.75;
}

.tp-related {
  display: flex;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.tp-chip {
  margin: 12rpx 12rpx 0 0;
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  color: var(--brand-dark);
  background: var(--brand-wash);
  border: 1rpx solid var(--brand-line);
  border-radius: 999rpx;
}

.tp-foot {
  height: 48rpx;
}
